# Text LLM
TEXT_PROVIDER=gemini # gemini / openai / ollama / llamacpp
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL= # MINIMAL / LOW / MEDIUM / HIGH / empty for default
GEMINI_MAX_OUTPUT_TOKENS=32768 # 8192 - 65536
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TEXT_MODEL=gpt-4o
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3
LLAMACPP_BASE_URL=http://localhost:8080
LLAMACPP_TEXT_MODEL=default

# TTS
TTS_PROVIDER=gemini # gemini / openai / piper
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
PIPER_BINARY_PATH=piper
PIPER_MODEL_PATH=

# Database
DB_PROVIDER=sqlite

# Listening Difficulties & TTS Cache
ENABLE_LISTENING_DIFFICULTIES=true
TTS_CACHE_MAX_MB=200
TTS_DAILY_WARN_LIMIT=200
